# trading 环境变量清单（唯一清单，见 docs/architecture/overview.md §8）
# 复制为仓库根的 .env 使用：cp .env.example .env
# 密钥不进仓库；生产环境必须显式覆盖下列默认值。

# 运行环境标识（dev / ci / prod）
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL（仅供 api/worker/scheduler 内网连接，不对外发布端口）
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=trading

# Redis：任务队列与短期缓存，不是唯一真相
REDIS_URL=redis://redis:6379/0

# 对外端口
API_PORT=8000
WEB_PORT=5173

# 公共行情上游地址。正常运行保持默认；只在故障注入验收（scripts/e2e/chaos.sh）里覆盖，
# 例如指到一个固定返回 429 的桩服务，用来验证限流降级与恢复。
OKX_REST_BASE_URL=https://www.okx.com

# scheduler 心跳：每 interval 秒写一次，超过 timeout 秒未更新即判定失联
SCHEDULER_HEARTBEAT_INTERVAL_SECONDS=5
SCHEDULER_HEARTBEAT_TIMEOUT_SECONDS=30

# P3 交易执行：真实交易默认关闭。未显式设为 true 时，任何真实下单都被拒绝。
REAL_TRADING_ENABLED=false
# OKX 私有接口凭据（只从这里注入，绝不写进代码）。留空即无法真实下单。
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# 实盘逐策略放行清单（逗号分隔 strategy.id）；空表示不放行任何策略。
EXECUTION_REAL_STRATEGY_IDS=
# paper 撮合分段比例；两步成交模拟部分成交（第一次轮询 partial，第二次 filled）。
EXECUTION_PAPER_FILL_CHUNKS=0.5,0.5
# 自动止损阈值：单腿浮亏占持仓均价的比例。
EXECUTION_STOP_LOSS_RATIO=0.05
