# trading 环境变量清单（唯一清单）
# 复制为仓库根的 .env 使用：cp .env.example .env
# 密钥不进仓库；生产环境必须显式覆盖下列默认值。

# 运行环境标识（dev / ci / prod）
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL 连接串（必填，没有内建默认值）。
# 默认值与 `make db-up` 起的本地 podman 容器一致；连别的库时整串替换。
DATABASE_URL=postgresql+psycopg://trading:trading@127.0.0.1:5432/trading
# 表所在的 schema；留空走连接默认的 search_path（public）。测试不靠它做隔离：
# 测试装配会把这一项从环境里清掉，隔离靠用例级 savepoint（见 AGENTS.md 第 5 节）。
# DATABASE_SCHEMA=

# 公共行情与私有交易接口的上游地址（同一个域名；模拟盘靠请求头区分）。
OKX_REST_BASE_URL=https://www.okx.com
OKX_HTTP_TIMEOUT_SECONDS=10

# 宏观数据源上游地址（可选，留空用代码里的默认值）。
# 财政部 CSV 的 {year} 由 treasury provider 替换成当前年份。
# MACRO_TREASURY_URL=
# MACRO_CBOE_URL=
# MACRO_YAHOO_TNX_URL=
# MACRO_YAHOO_VIX_URL=

# 美股数据源上游地址（可选，留空用代码里的默认值）。
# `{symbol}` 由 provider 替换成标的名；Stooq 的代码是小写 + 市场后缀，后缀写在模板里。
# `EQUITY_YAHOO_URL` 是分钟级、`EQUITY_YAHOO_DAILY_URL` 是日线：Yahoo 两种粒度是两份
# 上游摘要，各要一份模板；日线是 ATR 的唯一来源，不能省。
# 需要 API key 的供应商（Alpha Vantage / Finnhub / Polygon）同样只经环境变量注入，
# 本单只实现无需 key 的 Yahoo 与 Stooq。
# EQUITY_YAHOO_URL=
# EQUITY_YAHOO_DAILY_URL=
# EQUITY_STOOQ_URL=

# OKX 私有交易接口凭据（模拟盘或实盘，由 OKX_DEMO 决定走哪一侧）。
# 密钥只经环境变量注入，禁止写进仓库、issue 正文或日志。
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# 模拟盘（demo trading）：1 = 模拟盘（私有 WS 连 wspap、握手带 x-simulated-trading: 1），
# 0 = 实盘（连 ws、不带该头）。这个开关同时决定域名与默认端口，不只是请求头。
OKX_DEMO=1
# 私有 WebSocket 地址（可选）。留空按 OKX_DEMO 推导（上游已公告 8443 将退役，
# 默认走 443；模拟盘握手另带 `x-simulated-trading: 1`）：
#   1 → wss://wspap.okx.com:443/ws/v5/private
#   0 → wss://ws.okx.com:443/ws/v5/private
# OKX_WS_PRIVATE_URL=

# 行情适配层的限流与重试（按上游最紧的公共行情配额 20 次 / 2 秒折算）。
OKX_HTTP_MAX_RETRIES=3
OKX_RATE_LIMIT_CAPACITY=20
OKX_RATE_LIMIT_REFILL_PER_SECOND=10

# 技术类提醒用的 K 线周期：1h / 4h / 1d。上游频道名（candle1H 等）由适配层转换；
# 只在这根 K 线确认收盘时产生事件，未收盘的推送直接丢弃。
OKX_CANDLE_BAR=1h

# 通知通道的敏感值（与交易所密钥同一约定：只经环境变量注入，不落库、不回显）。
# 非敏感部分在设置页填写：Telegram 的 chat_id 与 Webhook 的接收地址存在设置文档里。
# 留空即视为未配置：通道开关打开也不会投递，台账里记「未配置」。
# TELEGRAM_BOT_TOKEN=
# WEBHOOK_SIGNING_SECRET=
# Telegram 机器人接口地址，只在需要换上游域名时才覆盖。
# TELEGRAM_API_BASE=https://api.telegram.org

# 持仓卡片列表的尘埃阈值（USDT）：名义价值低于它的持仓不展示，快照行照旧保留。
# 留空用代码默认值 1。
# POSITION_DUST_NOTIONAL=1
