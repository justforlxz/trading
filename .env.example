# trading 环境变量清单（唯一清单）
# 复制为仓库根的 .env 使用：cp .env.example .env
# 密钥不进仓库；生产环境必须显式覆盖下列默认值。

# 运行环境标识（dev / ci / prod）
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL 连接串（必填，没有内建默认值）。
# 默认值与 `make db-up` 起的本地 podman 容器一致；连别的库时整串替换。
DATABASE_URL=postgresql+psycopg://trading:trading@127.0.0.1:5432/trading
# 表所在的 schema；留空走连接默认的 search_path（public）。测试用独立临时 schema 隔离。
# DATABASE_SCHEMA=

# 公共行情与私有交易接口的上游地址（同一个域名；模拟盘靠请求头区分）。
OKX_REST_BASE_URL=https://www.okx.com
OKX_HTTP_TIMEOUT_SECONDS=10

# OKX 私有交易接口凭据（模拟盘或实盘，由 OKX_DEMO 决定走哪一侧）。
# 密钥只经环境变量注入，禁止写进仓库、issue 正文或日志。
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# 模拟盘（demo trading）：1 = 带 `x-simulated-trading: 1` 请求头，0 = 实盘。
OKX_DEMO=1

# 美股代理行情上游（只读公开接口，正常交易时段的参考价来源）。
US_EQUITY_REST_BASE_URL=https://query1.finance.yahoo.com
US_EQUITY_HTTP_TIMEOUT_SECONDS=10

# 行情适配层的限流与重试（按上游最紧的公共行情配额 20 次 / 2 秒折算）。
OKX_HTTP_MAX_RETRIES=3
OKX_RATE_LIMIT_CAPACITY=20
OKX_RATE_LIMIT_REFILL_PER_SECOND=10
