# trading 环境变量清单（唯一清单）
# 复制为仓库根的 .env 使用：cp .env.example .env
# 密钥不进仓库；生产环境必须显式覆盖下列默认值。

# 运行环境标识（dev / ci / prod）
APP_ENV=dev
LOG_LEVEL=INFO

# SQLite 库文件位置。默认 backend/data/trading.db（按后端包路径解析，与进程 cwd 无关）。
# 需要隔离时再显式覆盖为绝对路径。
# DATABASE_PATH=/absolute/path/to/trading.db

# 公共行情上游地址（只读公开 REST）。
OKX_REST_BASE_URL=https://www.okx.com
OKX_HTTP_TIMEOUT_SECONDS=10
